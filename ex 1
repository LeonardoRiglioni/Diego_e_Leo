def define_posicoes(linha, coluna, orientação, tamanho):
    lista_posiçao = []
    lista_posiçao.append([linha,coluna])
    i = 1
    while i < tamanho:
        if orientação == "vertical":
            lista_posiçao.append([linha+i,coluna])
        elif orientação =="horizontal":
            lista_posiçao.append([linha,coluna+i])
        i += 1
    return lista_posiçao

linha = 2
coluna = 4
orientação = "vertical"
tamanho = 3
print(define_posicoes(linha, coluna, orientação, tamanho))